{
  "name": "@commission-quote/vendor-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=cjs --sourcemap --outfile=dist/server.cjs",
    "start": "node --enable-source-maps dist/server.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include=src/**",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@commission-quote/contract": "1.0.0",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  }
}
