{
  "name": "@commission-quote/contract",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
