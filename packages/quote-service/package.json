{
  "name": "@commission-quote/quote-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node20 --format=cjs --sourcemap --outfile=dist/server.cjs",
    "start": "node --enable-source-maps dist/server.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@commission-quote/contract": "1.0.0",
    "express": "^4.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@commission-quote/vendor-api": "1.0.0",
    "@types/express": "^4.17.21",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  }
}
