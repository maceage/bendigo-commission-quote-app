# Copy to `.env` (repo root). `.env` is gitignored — never commit secrets.
# Requires Node 22.19+ (see README prerequisites).

# REQUIRED — shared secret for the mock vendor API. Any non-empty string.
VENDOR_API_KEY=change-me-dev-only

# OPTIONAL — where quote-service finds the vendor API.
# Default: http://localhost:4001 (the mock's default port)
# VENDOR_API_BASE_URL=http://localhost:4001

# OPTIONAL — probability (0 to 1) that the mock vendor fails a request.
# Default: 0.2. quote-service retries up to 3 times, so set this high
# (e.g. 0.7, or 1 for every request) to see the UI's error state.
# VENDOR_FAILURE_RATE=0.2

# OPTIONAL — probability (0 to 1) that the mock vendor never responds.
# Default: 0.05. Each hang costs quote-service a 3s timeout before it
# retries; set to 1 to see the UI's timeout error (after about 8s).
# VENDOR_TIMEOUT_RATE=0.05

# OPTIONAL — file where the mock vendor keeps the quotes it has issued, by
# Idempotency-Key, so a retry after a restart still gets the original
# quote (its folder is created if needed). Default: in memory only, so a
# restart forgets them. Docker Compose sets this to a file on a volume.
# VENDOR_IDEMPOTENCY_FILE=/path/to/vendor-idempotency.json

# OPTIONAL — log detail for both backends (pino levels: trace, debug,
# info, warn, error, fatal, silent). Default: info.
# LOG_LEVEL=info
