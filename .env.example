# Copy to `.env` (repo root). `.env` is gitignored — never commit secrets.
# Requires Node 18+ ; load via `tsx watch --env-file=../../.env` (see package.json).

# REQUIRED — shared secret for the mock vendor API. Any non-empty string.
VENDOR_API_KEY=change-me-dev-only

# OPTIONAL — where quote-service finds the vendor API.
# Default: http://localhost:4001 (the mock's default port)
# VENDOR_API_BASE_URL=http://localhost:4001